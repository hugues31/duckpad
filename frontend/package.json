{
  "name": "duckpad-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc -b && npm run check:i18n",
    "check:i18n": "node scripts/check-i18n.mjs",
    "lint": "eslint .",
    "format": "prettier --write src e2e docs scripts playwright*.config.ts vite.config.ts eslint.config.js",
    "format:check": "prettier --check src e2e docs scripts playwright*.config.ts vite.config.ts eslint.config.js",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "docs:capture": "playwright test --config playwright.docs.config.ts",
    "docs:screenshots": "playwright test --config playwright.docs.config.ts screenshots.spec.ts",
    "docs:test": "playwright test --config playwright.site.config.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.9.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.2.0",
    "vitest": "^4.1.12"
  }
}
