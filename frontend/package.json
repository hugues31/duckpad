{
  "name": "duckpad-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "format": "prettier --write src e2e docs playwright*.config.ts vite.config.ts",
    "format:check": "prettier --check src e2e docs playwright*.config.ts vite.config.ts",
    "test:e2e": "playwright test",
    "docs:capture": "playwright test --config playwright.docs.config.ts",
    "docs:test": "playwright test --config playwright.site.config.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.9.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  }
}
