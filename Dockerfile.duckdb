# Build context: the validated wheel directory, not the repository root.
FROM python:3.12-slim-bookworm
# Coolify's cleanup skips tagged images carrying this label.
LABEL coolify.managed="true" org.opencontainers.image.title="Duckpad portable DuckDB 2.0 runtime"
COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY *.whl /tmp/duckdb-wheels/
RUN uv venv /app/.venv \
    && uv pip install --python /app/.venv/bin/python --no-index \
       --find-links /tmp/duckdb-wheels duckdb==2.0.0 \
    && /app/.venv/bin/python -c "import duckdb; assert duckdb.__version__ == '2.0.0'; assert duckdb.sql('select 42').fetchone() == (42,)" \
    && rm -rf /tmp/duckdb-wheels
