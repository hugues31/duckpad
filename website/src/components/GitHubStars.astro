---
import { getGitHubStars } from "../lib/github-stars";
const stars = await getGitHubStars();
const count = stars?.toLocaleString("en-US");
---

<a
  class="github-stars"
  href="https://github.com/hugues31/duckpad"
  aria-label={
    stars === null
      ? "Star Duckpad on GitHub"
      : `Duckpad on GitHub, ${count} ${stars === 1 ? "star" : "stars"}`
  }
  title={
    stars === null
      ? "Star Duckpad on GitHub"
      : "GitHub stars at the latest site build"
  }
>
  <svg
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.23.71-1.51-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15a10.8 10.8 0 0 1 5.63 0c2.15-1.45 3.1-1.15 3.1-1.15.61 1.55.23 2.7.11 2.98.72.79 1.16 1.79 1.16 3.02 0 4.32-2.64 5.27-5.15 5.55.4.35.76 1.03.76 2.08v3.12c0 .3.2.65.77.54A11.25 11.25 0 0 0 12 .75Z" />
  </svg>
  <span>GitHub</span>
  <span class="github-stars-count" aria-hidden="true">
    <svg
      width="13"
      height="13"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linejoin="round"
    >
      <path d="m12 3 2.78 5.63L21 9.54l-4.5 4.38 1.06 6.2L12 17.2l-5.56 2.92 1.06-6.2L3 9.54l6.22-.91Z" />
    </svg>
    {count ?? "Star"}
  </span>
</a>

<style>
  a.github-stars {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--surface);
    font-size: 12px;
    font-weight: 650;
    white-space: nowrap;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease;
  }
  .github-stars:hover {
    border-color: var(--blue);
    box-shadow: 0 2px 10px #226bff12;
    color: var(--blue);
  }
  .github-stars-count {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding-left: 8px;
    border-left: 1px solid var(--line);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .github-stars-count svg {
    color: var(--blue);
  }
</style>
