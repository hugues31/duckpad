---
// Cards, sockets and connections share SVG coordinates, including their rotations.
const orders = { x: 24, y: 94, width: 184, height: 76, angle: -5 };
const customers = { x: 264, y: 109, width: 198, height: 76, angle: 5 };
const aggregate = { x: 122, y: 278, width: 260, height: 78, angle: 0 };
const report = { x: 147, y: 400, width: 220, height: 42, angle: -3 };
type Card = typeof orders;
const transform = (card: Card) =>
  `translate(${card.x} ${card.y}) rotate(${card.angle} ${card.width / 2} ${card.height / 2})`;
function socket(card: Card, x: number, y: number) {
  const angle = (card.angle * Math.PI) / 180;
  const dx = x - card.width / 2;
  const dy = y - card.height / 2;
  return {
    x: card.x + card.width / 2 + dx * Math.cos(angle) - dy * Math.sin(angle),
    y: card.y + card.height / 2 + dx * Math.sin(angle) + dy * Math.cos(angle),
  };
}
function connect(
  from: ReturnType<typeof socket>,
  to: ReturnType<typeof socket>,
) {
  const middle = (from.y + to.y) / 2;
  return `M${from.x} ${from.y} C${from.x} ${middle} ${to.x} ${middle} ${to.x} ${to.y}`;
}
const connections = [
  connect(
    socket(orders, orders.width / 2, orders.height),
    socket(aggregate, 65, 0),
  ),
  connect(
    socket(customers, customers.width / 2, customers.height),
    socket(aggregate, 195, 0),
  ),
  connect(
    socket(aggregate, aggregate.width / 2, aggregate.height),
    socket(report, report.width / 2, 0),
  ),
].join(" ");
---

<div
  class="flow-art"
  role="img"
  aria-label="Illustration: orders and customers join, aggregate and become a traceable revenue report."
>
  <div class="art-grid"></div>
  <span class="art-label">A LITTLE LOGIC. A CLEARER PICTURE.</span>
  <svg class="flow-diagram" viewBox="0 0 480 470" aria-hidden="true">
    <g class="flow-scene">
      <g class="flow-lines">
        <path d={connections} />
      </g>
      <g class="flow-node" transform={transform(orders)}>
        <rect
          class="node-card"
          width={orders.width}
          height={orders.height}
          rx="8"
        />
        <rect
          class="icon-background"
          x="16"
          y="20"
          width="36"
          height="36"
          rx="5"
        />
        <svg
          class="node-icon"
          x="22"
          y="26"
          width="24"
          height="24"
          viewBox="0 0 24 24"
        >
          <path d="M6 3h8l4 4v14H6V3Zm8 0v5h4M9 12h6m-6 4h6" />
        </svg>
        <text class="node-title" x="64" y="32">
          Orders
        </text>
        <text class="node-caption" x="64" y="51">
          orders.csv
        </text>
        <circle
          class="node-port"
          cx={orders.width / 2}
          cy={orders.height}
          r="4"
        />
      </g>
      <g class="flow-node" transform={transform(customers)}>
        <rect
          class="node-card"
          width={customers.width}
          height={customers.height}
          rx="8"
        />
        <rect
          class="icon-background"
          x="16"
          y="20"
          width="36"
          height="36"
          rx="5"
        />
        <svg
          class="node-icon"
          x="22"
          y="26"
          width="24"
          height="24"
          viewBox="0 0 24 24"
        >
          <path d="M3 4h18v16H3V4Zm0 5h18M9 9v11m6-11v11M3 14h18" />
        </svg>
        <text class="node-title" x="64" y="32">
          Customers
        </text>
        <text class="node-caption" x="64" y="51">
          customers.parquet
        </text>
        <circle
          class="node-port"
          cx={customers.width / 2}
          cy={customers.height}
          r="4"
        />
      </g>
      <g class="flow-node" transform={transform(aggregate)}>
        <rect
          class="node-card aggregate-card"
          width={aggregate.width}
          height={aggregate.height}
          rx="8"
        />
        <rect
          class="icon-background"
          x="16"
          y="21"
          width="36"
          height="36"
          rx="5"
        />
        <svg
          class="node-icon"
          x="22"
          y="27"
          width="24"
          height="24"
          viewBox="0 0 24 24"
        >
          <path d="M3 6h4l10 12h4M3 18h4L17 6h4M18 3l3 3-3 3m0 6 3 3-3 3" />
        </svg>
        <text class="node-title" x="64" y="33">
          Enrich &amp; aggregate
        </text>
        <text class="node-caption" x="64" y="52">
          A little SQL goes a long way.
        </text>
        <circle class="node-port" cx="65" cy="0" r="4" />
        <circle class="node-port" cx="195" cy="0" r="4" />
        <circle
          class="node-port"
          cx={aggregate.width / 2}
          cy={aggregate.height}
          r="4"
        />
      </g>
      <g class="report-node" transform={transform(report)}>
        <rect
          class="report-card"
          width={report.width}
          height={report.height}
          rx="5"
        />
        <circle class="node-port" cx={report.width / 2} cy="0" r="4" />
        <circle class="report-dot" cx="18" cy="21" r="3.5" />
        <text class="report-label" x="30" y="25">
          One number. Every source.
        </text>
      </g>
    </g>
  </svg>
  <span class="art-coordinate">01 / FOLLOW THE DATA</span>
</div>

<style>
  .flow-diagram {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .flow-scene {
    transform-box: view-box;
    transform-origin: center;
    animation: float-flow 10s ease-in-out infinite;
  }
  @keyframes float-flow {
    0%,
    100% {
      transform: translateY(4px) rotate(-0.5deg);
    }
    50% {
      transform: translateY(-4px) rotate(0.5deg);
    }
  }
  .flow-lines path {
    fill: none;
    stroke: #73a1ff;
    stroke-width: 1.8;
    stroke-dasharray: 5 5;
  }
  .node-card {
    fill: var(--surface);
    stroke: var(--line);
    filter: drop-shadow(0 8px 10px #132e6110);
  }
  .aggregate-card {
    stroke: #7ea5fc;
  }
  .icon-background,
  .report-card {
    fill: var(--soft);
  }
  .node-icon {
    fill: none;
    stroke: var(--blue);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .node-title {
    fill: var(--ink);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: -0.3px;
  }
  .node-caption {
    fill: var(--muted);
    font-family: ui-monospace, monospace;
    font-size: 8px;
  }
  .node-port {
    fill: var(--surface);
    stroke: #226bff;
    stroke-width: 1.8;
  }
  .report-card {
    stroke: #aac4fc;
  }
  .report-dot {
    fill: #226bff;
  }
  .report-label {
    fill: var(--ink);
    font-size: 11px;
    font-weight: 650;
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-scene {
      animation: none;
    }
  }
</style>
