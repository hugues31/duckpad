---
import { cards, transform, connectionsFor } from "../lib/flow-illustration";
const [orders, customers, aggregate, report] = cards;
const connections = connectionsFor(cards);
---

<div
  class="flow-art"
  role="img"
  aria-label="Illustration: orders and customers join, aggregate and become a traceable revenue report."
>
  <div class="art-grid"></div>
  <span class="art-label">A LITTLE LOGIC. A CLEARER PICTURE.</span>
  <svg class="flow-diagram" viewBox="0 0 480 470" aria-hidden="true">
    <g class="flow-scene">
      <g class="flow-lines">
        <path d={connections} />
      </g>
      <g class="flow-node" data-flow-card transform={transform(orders)}>
        <rect
          class="node-card"
          width={orders.width}
          height={orders.height}
          rx="8"
        />
        <rect
          class="icon-background"
          x="16"
          y="20"
          width="36"
          height="36"
          rx="5"
        />
        <svg
          class="node-icon"
          x="22"
          y="26"
          width="24"
          height="24"
          viewBox="0 0 24 24"
        >
          <path d="M6 3h8l4 4v14H6V3Zm8 0v5h4M9 12h6m-6 4h6" />
        </svg>
        <text class="node-title" x="64" y="32">
          Orders
        </text>
        <text class="node-caption" x="64" y="51">
          orders.csv
        </text>
        <circle
          class="node-port"
          cx={orders.width / 2}
          cy={orders.height}
          r="4"
        />
      </g>
      <g class="flow-node" data-flow-card transform={transform(customers)}>
        <rect
          class="node-card"
          width={customers.width}
          height={customers.height}
          rx="8"
        />
        <rect
          class="icon-background"
          x="16"
          y="20"
          width="36"
          height="36"
          rx="5"
        />
        <svg
          class="node-icon"
          x="22"
          y="26"
          width="24"
          height="24"
          viewBox="0 0 24 24"
        >
          <path d="M3 4h18v16H3V4Zm0 5h18M9 9v11m6-11v11M3 14h18" />
        </svg>
        <text class="node-title" x="64" y="32">
          Customers
        </text>
        <text class="node-caption" x="64" y="51">
          customers.parquet
        </text>
        <circle
          class="node-port"
          cx={customers.width / 2}
          cy={customers.height}
          r="4"
        />
      </g>
      <g class="flow-node" data-flow-card transform={transform(aggregate)}>
        <rect
          class="node-card aggregate-card"
          width={aggregate.width}
          height={aggregate.height}
          rx="8"
        />
        <rect
          class="icon-background"
          x="16"
          y="21"
          width="36"
          height="36"
          rx="5"
        />
        <svg
          class="node-icon"
          x="22"
          y="27"
          width="24"
          height="24"
          viewBox="0 0 24 24"
        >
          <path d="M3 6h4l10 12h4M3 18h4L17 6h4M18 3l3 3-3 3m0 6 3 3-3 3" />
        </svg>
        <text class="node-title" x="64" y="33">
          Enrich &amp; aggregate
        </text>
        <text class="node-caption" x="64" y="52">
          A little SQL goes a long way.
        </text>
        <circle class="node-port" cx="65" cy="0" r="4" />
        <circle class="node-port" cx="195" cy="0" r="4" />
        <circle
          class="node-port"
          cx={aggregate.width / 2}
          cy={aggregate.height}
          r="4"
        />
      </g>
      <g class="report-node" data-flow-card transform={transform(report)}>
        <rect
          class="report-card"
          width={report.width}
          height={report.height}
          rx="5"
        />
        <circle class="node-port" cx={report.width / 2} cy="0" r="4" />
        <circle class="report-dot" cx="18" cy="21" r="3.5" />
        <text class="report-label" x="30" y="25">
          One number. Every source.
        </text>
      </g>
    </g>
  </svg>
  <span class="art-coordinate">01 / FOLLOW THE DATA</span>
</div>

<script>
  import {
    animatedCards,
    cards,
    connectionsFor,
    transform,
  } from "../lib/flow-illustration";

  document.querySelectorAll<HTMLElement>(".flow-art").forEach((art) => {
    const nodes = [...art.querySelectorAll<SVGGElement>("[data-flow-card]")];
    const path = art.querySelector<SVGPathElement>(".flow-lines path")!;
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    let visible = false;
    let frame: number | undefined;
    let previous: number | undefined;
    let elapsed = 0;

    function render(poses: typeof cards) {
      nodes.forEach((node, index) =>
        node.setAttribute("transform", transform(poses[index])),
      );
      // Move the nodes and their socket endpoints in the same animation frame.
      path.setAttribute("d", connectionsFor(poses));
    }

    function tick(time: number) {
      elapsed +=
        previous === undefined ? 0 : Math.min(time - previous, 100) / 1000;
      previous = time;
      render(animatedCards(elapsed));
      frame = requestAnimationFrame(tick);
    }

    function sync() {
      const running = visible && !document.hidden && !reducedMotion.matches;
      art.toggleAttribute("data-animating", running);
      if (frame !== undefined) cancelAnimationFrame(frame);
      frame = undefined;
      previous = undefined;
      if (reducedMotion.matches) {
        elapsed = 0;
        render(cards);
      }
      if (running) frame = requestAnimationFrame(tick);
    }

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      sync();
    }).observe(art);
    reducedMotion.addEventListener("change", sync);
    document.addEventListener("visibilitychange", sync);
  });
</script>

<style>
  .flow-diagram {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  @keyframes dash-flow {
    to {
      stroke-dashoffset: -60;
    }
  }
  .flow-lines path {
    fill: none;
    stroke: #73a1ff;
    stroke-width: 1.8;
    stroke-dasharray: 5 5;
    animation: dash-flow 18s linear infinite;
    animation-play-state: paused;
  }
  .flow-art[data-animating] .flow-lines path {
    animation-play-state: running;
  }
  .node-card {
    fill: var(--surface);
    stroke: var(--line);
    filter: drop-shadow(0 8px 10px #132e6110);
  }
  .aggregate-card {
    stroke: #7ea5fc;
  }
  .icon-background,
  .report-card {
    fill: var(--soft);
  }
  .node-icon {
    fill: none;
    stroke: var(--blue);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .node-title {
    fill: var(--ink);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: -0.3px;
  }
  .node-caption {
    fill: var(--muted);
    font-family: ui-monospace, monospace;
    font-size: 8px;
  }
  .node-port {
    fill: var(--surface);
    stroke: #226bff;
    stroke-width: 1.8;
  }
  .report-card {
    stroke: #aac4fc;
  }
  .report-dot {
    fill: #226bff;
  }
  .report-label {
    fill: var(--ink);
    font-size: 11px;
    font-weight: 650;
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-lines path {
      animation: none;
    }
  }
</style>
