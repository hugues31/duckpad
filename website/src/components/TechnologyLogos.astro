---
import { url } from "../lib/docs";

const technologies = [
  {
    name: "DuckDB",
    icon: "duckdb",
    role: "SQL engine",
    href: "https://duckdb.org/",
  },
  {
    name: "Python",
    icon: "python",
    role: "Runtime",
    href: "https://www.python.org/",
  },
  {
    name: "Git",
    icon: "git",
    role: "Version control",
    href: "https://git-scm.com/",
  },
  {
    name: "Apache Parquet",
    icon: "parquet",
    role: "Columnar files",
    href: "https://parquet.apache.org/",
  },
];
---

<section
  class="technology-strip wrap"
  aria-label="Built with open-source tools"
>
  <p>BUILT ON OPEN SOURCE</p>
  <ul>
    {technologies.map((technology) => (
      <li>
        <a href={technology.href}>
          <img
            src={url(`logos/${technology.icon}.svg`)}
            alt=""
            width="40"
            height="40"
          />
          <span>
            <b>{technology.name}</b>
            <small>{technology.role}</small>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .technology-strip {
    display: flex;
    align-items: center;
    gap: 48px;
    padding-block: 25px;
    margin-bottom: 55px;
    border-block: 1px solid var(--line);
  }
  .technology-strip > p {
    flex: 0 0 auto;
    font-family: ui-monospace, monospace;
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 0.08em;
  }
  ul {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  a {
    display: flex;
    align-items: center;
    gap: 12px;
    width: fit-content;
  }
  a:hover b {
    color: var(--blue);
  }
  img {
    flex: 0 0 40px;
    object-fit: contain;
  }
  b {
    display: block;
    font-size: 13px;
    font-weight: 650;
  }
  small {
    display: block;
    margin-top: 4px;
    font-size: 10px;
    color: var(--muted);
  }
  @media (max-width: 1100px) {
    .technology-strip {
      gap: 24px;
    }
    .technology-strip > p {
      max-width: 90px;
      line-height: 1.8;
    }
    ul {
      gap: 20px;
    }
    a {
      gap: 8px;
    }
    b {
      font-size: 12px;
    }
  }
  @media (max-width: 760px) {
    .technology-strip {
      display: block;
      margin-bottom: 35px;
    }
    .technology-strip > p {
      max-width: none;
      margin-bottom: 24px;
    }
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 12px;
    }
  }
</style>
