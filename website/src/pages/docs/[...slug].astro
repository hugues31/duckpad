---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Demo from "../../components/Demo.astro";
import DocsNav from "../../components/DocsNav.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { pages, url } from "../../lib/docs";
export async function getStaticPaths() {
  return (await getCollection("docs")).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const index = pages.findIndex((page) => page.slug === entry.id);
const meta = pages[index];
if (!meta) throw new Error(`No navigation entry for ${entry.id}`);
const { Content, headings } = await render(entry);
const previous = pages[index - 1];
const next = pages[index + 1];
const outline = headings.filter(
  (heading) => heading.depth >= 1 && heading.depth <= 3,
);
const hasOutline = outline.some((heading) => heading.depth > 1);
---

<Layout
  title={`${meta.title} — Duckpad docs`}
  description={meta.description}
  docs
>
  <DocsNav slot="menu" current={entry.id} label="Documentation on mobile" />
  <div class="docs-shell">
    <aside class="docs-sidebar">
      <DocsNav current={entry.id} label="Documentation" />
    </aside>
    <main class="docs-content" id="main">
      {hasOutline && (
        <details class="mobile-toc">
          <summary>
            <span class="mobile-toc-label">On this page</span>
            <span class="mobile-toc-current" data-toc-current />
            <svg
              class="mobile-toc-chevron"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <TableOfContents headings={outline} label="Sections of this page" />
        </details>
      )}
      <p class="breadcrumb">DOCUMENTATION / {meta.title.toUpperCase()}</p>
      <article class="prose">
        <Content />
      </article>
      {entry.id === "example" && <Demo />}
      <footer class="doc-bottom">
        <a
          class="doc-edit"
          href={`https://github.com/hugues31/duckpad/edit/main/docs/${entry.id.toUpperCase()}.md`}
        >
          Improve this page on GitHub ↗
        </a>
        <nav class="doc-pagination" aria-label="Previous and next guides">
          {previous && (
            <a class="doc-previous" href={url(`docs/${previous.slug}/`)}>
              <small>Previous</small>
              <span>
                <span aria-hidden="true">←</span> {previous.title}
              </span>
            </a>
          )}
          {next && (
            <a class="doc-next" href={url(`docs/${next.slug}/`)}>
              <small>Next</small>
              <span>
                {next.title} <span aria-hidden="true">→</span>
              </span>
            </a>
          )}
        </nav>
      </footer>
    </main>
    <aside class="table-of-contents">
      {hasOutline && (
        <TableOfContents
          headings={outline}
          label="On this page"
          title="On this page"
        />
      )}
    </aside>
  </div>
</Layout>

<script>
  import "../../lib/toc";

  // Scroll the sidebar to the current guide when it would start out of view.
  const sidebar = document.querySelector<HTMLElement>(".docs-sidebar nav");
  const current = sidebar?.querySelector<HTMLElement>("[aria-current='page']");
  if (sidebar && current && current.offsetTop > sidebar.clientHeight * 0.8)
    sidebar.scrollTop = current.offsetTop - sidebar.clientHeight / 3;
</script>
