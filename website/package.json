{
  "name": "duckpad-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --ignore-lock",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --ignore-lock",
    "format": "prettier --write src scripts astro.config.mjs",
    "format:check": "prettier --check src scripts astro.config.mjs",
    "test": "node --test src/lib/releases.test.ts",
    "releases:update": "node scripts/update-releases.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@fontsource-variable/manrope": "^5.2.8",
    "astro": "7.4.2",
    "rehype-sanitize": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^7.0.2"
  }
}
